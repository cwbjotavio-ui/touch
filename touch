              {mode === 'tap' ? '👆' : '👇'}
            </div>
            <h2 className={`text-3xl font-black text-center ${flashOn ? 'text-white' : 'text-red-200'}`}>
              {mode === 'tap' ? 'TOQUE!' : 'SEGURE!'}
            </h2>
