  useEffect(() => {
    if (!isActive) { setCompleted(false); setWaiting(true); setHoldProgress(0); setIsHolding(false); }
  }, [isActive]);

  return (
    <div className={`fixed inset-0 flex flex-col items-center justify-center select-none transition-colors duration-75 ${waiting ? 'bg-gray-900' : completed ? 'bg-green-700' : flashOn ? 'bg-red-600' : 'bg-gray-900'}`}
