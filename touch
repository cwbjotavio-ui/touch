      <p>3. No mestre, toque no jogador para ativar a luz!</p>
    </div>

    <div class="tip">
      <strong>Dica:</strong> Salve o link nos favoritos do celular para acessar rápido depois!
    </div>

    <div style="text-align: center; margin: 40px 0; color: #8b949e;">
      <p>Feito com ❤️ para diversão em grupo</p>
      <p style="font-size: 0.8em; margin-top: 5px;">TOUCH — Jogo de Reflexo Multiplayer</p>
    </div>

  </div>

  <script>
    function copyContent(btn, elementId) {
      const el = document.getElementById(elementId);
      const text = el.textContent;

      navigator.clipboard.writeText(text).then(() => {
        btn.textContent = '✅ Copiado!';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = '📋 Copiar';
          btn.classList.remove('copied');
        }, 2000);
      }).catch(() => {
        // Fallback
        const textarea = document.createElement('textarea');
        textarea.value = text;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        btn.textContent = '✅ Copiado!';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = '📋 Copiar';
          btn.classList.remove('copied');
        }, 2000);
      });
    }
  </script>
</body>
